HOST=0.0.0.0
PORT=8741
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,*

DEFAULT_PITCHER_ID=808967
DEFAULT_PITCHER_NAME=Yoshinobu Yamamoto
DEFAULT_START_DATE=2024-03-28
DEFAULT_END_DATE=2024-09-30
DEFAULT_GAME_PK=746168
DODGERS_STARTER_IDS=808967,607192,621111,676272,694297,477132
DODGERS_TEAM_ID=119

DATA_DIR=../data
CACHE_DIR=../data/cache
SAMPLE_DATA_PATH=../data/sample/yamamoto_2024_sample.csv
MODELS_DIR=../models
PREDICTION_LOG_PATH=../data/logs/predictions.jsonl
STATCAST_BASE_URL=https://baseballsavant.mlb.com/statcast_search/csv

# false = download/cache Statcast for starters; sample is explicit fallback for default pitcher only
USE_SAMPLE_DATA=false
PREFER_ML_PREDICTIONS=true
LIVE_POLL_INTERVAL_SEC=3
SCHEDULE_POLL_INTERVAL_SEC=20
AUTO_START_WORKERS=true

# PostgreSQL (see docker-compose.yml)
DATABASE_URL=postgresql+psycopg://pitch:pitch@127.0.0.1:5432/pitch_intel
